#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform PushConstants {
  int rb;
  float cellSize;
  float dt;
  ivec4 cellCount;      // xyz used
  // dyeDecay/velocityDecay unused here - present only so gridOrigin below
  // lands at the correct byte offset (48), matching
  // SmokeSys::ComputePushConstants.
  float dyeDecay;
  float velocityDecay;
  ivec4 gridOrigin;     // xyz used
} pc;

#include "common.glsl"

void main() {
  ivec3 dims = pc.cellCount.xyz;
  ivec3 p = ivec3(gl_GlobalInvocationID);
  if (p.x >= dims.x || p.y >= dims.y || p.z >= dims.z)
    return;

  float dtRhoSize = (density * pc.cellSize / pc.dt);

  if (isSolid(p, dims)) {
    setDiv(p, dims, 0.0);
    return;
  }

  // Neighbor face velocities, clamped to the currently active window
  // (see common.glsl's clampToWindow) rather than raw-wrapped: a bare
  // wrapCoord() here would let p+1 alias the window's OPPOSITE face
  // whenever p itself sits on the window's far face - a physically
  // distant cell, not a true neighbor. Clamping instead substitutes p's
  // own velocity at that face (zero-gradient/free-slip wall), so the
  // window boundary no longer contributes spurious divergence from a
  // phantom link to the far side.
  ivec3 gridOrigin = pc.gridOrigin.xyz;
  vec3 velHere = getVel(p, dims);
  vec3 velXp = getVel(clampToWindow(p + ivec3(1, 0, 0), p, gridOrigin, dims), dims);
  vec3 velYp = getVel(clampToWindow(p + ivec3(0, 1, 0), p, gridOrigin, dims), dims);
  vec3 velZp = getVel(clampToWindow(p + ivec3(0, 0, 1), p, gridOrigin, dims), dims);

  float div = velXp.x - velHere.x + velYp.y - velHere.y + velZp.z - velHere.z;
  setDiv(p, dims, div * dtRhoSize);
}
