#version 450
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Deliberately its own tiny standalone set - NOT common.glsl's 7-binding
// compute set (that one is private to SmokeSys).
//
// Was a `readonly image3D` sampled with a hand-rolled 8-imageLoad trilinear
// per march step. Now a real sampler3D (REPEAT addressing, same sampler the
// composite pass uses for the dye - see SmokeCompositeEffect::
// smokeVolumeSampler): one hardware-filtered fetch per step instead of 8
// loads plus modulo/wrap math.
layout(set = 0, binding = 0) uniform sampler3D dyeVolume;

// Descriptor-indexed array of per-light output volumes - was two packed
// rgba32f volumes (4 lights/channel, MAX_POINT_LIGHTS = 8). One
// single-channel r32f volume per light now; only the first
// pc.shadowedLightCount entries are written this dispatch (see main()).
// Must be the LAST binding in this set (Vulkan requirement for a
// partially-bound/variable-count binding).
#define TRANSMITTANCE_CAPACITY 16
layout(set = 0, binding = 1, r32f) uniform writeonly image3D transmittanceVolumes[TRANSMITTANCE_CAPACITY];

struct PointLight {
  vec4 positionAndRadius; // xyz = world pos, w = falloff radius (0 = pure inverse-square)
  vec4 colorAndIntensity; // rgb = color, w = intensity
};

// Storage buffer with a runtime array - was a fixed-size UBO array.
layout(std430, set = 0, binding = 2) readonly buffer PointLightsSsbo {
  PointLight lights[];
} lightsBuf;

layout(push_constant) uniform TransmittancePush {
  ivec4 cellCount;  // xyz used
  ivec4 gridOrigin; // xyz used - current window origin, see main()
  float cellSize;
  // Lights farther than this from the grid's world-space AABB are skipped
  // (treated as fully transmissive, no march).
  float maxLightDistance;
  // How many transmittance volume slots to fill this dispatch - always
  // the first shadowedLightCount lights, by convention on the CPU side
  // (see SmokeCompositeEffect::beforeDispatch).
  int shadowedLightCount;
  // Resolution divisor of the transmittance volumes relative to the dye
  // grid (1 = same resolution, 2 = half resolution per axis = 1/8 of the
  // texels). Transmittance is a smooth low-frequency field and is read back
  // with a trilinear sampler, so half-res is visually indistinguishable but
  // 8x cheaper. See SmokeCompositeEffect::kTransmittanceStride.
  int stride;
} pc;

ivec3 wrapCoord(ivec3 p, ivec3 dims) {
  return ((p % dims) + dims) % dims;
}

// Integer floor division for possibly-negative gridOrigin (GLSL's / truncates
// toward zero).
ivec3 floorDiv(ivec3 a, int b) {
  ivec3 q = a / b;
  ivec3 r = a - q * b;
  return q - ivec3(lessThan(r, ivec3(0)));
}

// Marches toward the light through the dye field accumulating optical
// depth, Beer-Lambert it into a transmittance factor. Same reach as before
// (32 cells), but in `stride`-cell steps: the dye field is smooth and
// trilinearly filtered, so 16 two-cell steps track 32 one-cell steps closely
// while halving the fetch count again.
//
// UVW is worldPos / (dims * cellSize) with NO half-cell offset - identical
// to smoke.comp's uvwOf(), i.e. texel i is centered at world (i + 0.5) *
// cellSize. (The old hand-rolled sampler placed texel i at world i *
// cellSize, half a cell off from how the composite pass reads the same
// volume - this makes the two agree.)
//
// boxMin/boxMax clamp each step exactly as before, so the march never
// crosses the window edge into the toroidally-wrapped far side.
float marchTransmittance(vec3 worldPos, vec3 lightPos, ivec3 dims,
                         vec3 boxMin, vec3 boxMax) {
  vec3 toLight = lightPos - worldPos;
  float dist = length(toLight);
  vec3 dir = toLight / max(dist, 1e-4);

  const int SHADOW_CELLS_MAX = 32;
  int stride = max(pc.stride, 1);
  int maxSteps = SHADOW_CELLS_MAX / stride;
  float stepLen = pc.cellSize * float(stride);
  vec3 uvwScale = 1.0 / (vec3(dims) * pc.cellSize);

  float opticalDepth = 0.0;
  float traveled = 0.0;
  vec3 p = worldPos;
  for (int i = 0; i < maxSteps && traveled < dist; i++) {
    p += dir * stepLen;
    traveled += stepLen;
    vec3 clampedP = clamp(p, boxMin, boxMax - vec3(1e-3));
    opticalDepth += texture(dyeVolume, clampedP * uvwScale).r * stepLen;
  }
  return exp(-opticalDepth);
}

void main() {
  ivec3 dims = pc.cellCount.xyz;
  int stride = max(pc.stride, 1);
  ivec3 outDims = dims / stride; // size of the transmittance volumes
  ivec3 p = ivec3(gl_GlobalInvocationID);
  if (p.x >= outDims.x || p.y >= outDims.y || p.z >= outDims.z)
    return;

  // Coarse cell `cw` in absolute (toroidal) world coordinates: cell p of the
  // window's coarse lattice, anchored to gridOrigin's floor-division so the
  // lattice stays fixed in world space as the window recenters (for
  // stride 1 this is exactly the old gridOrigin + p). Its center sits at
  // (cw + 0.5) * stride cells - which is also where a REPEAT-sampled texel
  // storageP is centered when read back via worldPos / (dims * cellSize).
  // With stride > 1 the coarse lattice can be up to (stride - 1) fine cells
  // short of the window's far edge (when gridOrigin isn't a multiple of
  // stride); smoke fades out there anyway (see edgeFadeCells).
  ivec3 cw = floorDiv(pc.gridOrigin.xyz, stride) + p;
  vec3 worldPos = (vec3(cw) + 0.5) * float(stride) * pc.cellSize;

  // Storage index: the same toroidal convention as dyeVolume (wrap of the
  // absolute world cell), just at the coarse resolution - see the long
  // comment this replaces in git history for why raw `p` is wrong.
  ivec3 storageP = wrapCoord(cw, outDims);

  vec3 boxMin = vec3(pc.gridOrigin.xyz) * pc.cellSize;
  vec3 boxMax = boxMin + vec3(dims) * pc.cellSize;

  // l is dynamically uniform (loop bound is a push constant), so indexing
  // transmittanceVolumes[l] needs no nonuniformEXT decoration.
  for (int l = 0; l < pc.shadowedLightCount; l++) {
    vec3 lightPos = lightsBuf.lights[l].positionAndRadius.xyz;
    vec3 closest = clamp(lightPos, boxMin, boxMax);
    float dist = length(lightPos - closest);

    // Fade to fully-transmissive over the last quarter of the range instead
    // of a hard cut at pc.maxLightDistance (avoids a pop).
    float fadeStart = pc.maxLightDistance * 0.75;
    float fade = 1.0 - smoothstep(fadeStart, pc.maxLightDistance, dist);

    float trans = 1.0;
    if (fade > 0.0)
      trans = mix(1.0, marchTransmittance(worldPos, lightPos, dims, boxMin, boxMax), fade);

    imageStore(transmittanceVolumes[l], storageP, vec4(trans, 0.0, 0.0, 0.0));
  }
}
