#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer FFTDataOut {
  vec2 FFTData[];
};
struct BaseWaveHeight {
  vec2 heightAmp;      ///< FT amplitude of wave height
  vec2 heightAmp_conj; ///< conjugate of wave height amplitude
  float dispersion;    ///< Descrete dispersion value
  float pad;           //  4
};
layout(std430, binding = 1) buffer BaseWaveHeightFieldIn {
  BaseWaveHeight baseWaveHeightField[];
};

struct WaveVector {
  vec2 vec;
  vec2 unit;
};
layout(std430, binding = 2) buffer WaveVectorsIn {
  WaveVector waveVectors[];
};

layout (constant_id = 0) const uint tileSize = 512;
layout (constant_id = 1) const uint detailCascade = 0;

// Was hardcoded (const vec2 windDir = vec2(1,0); const float windSpeed =
// 20.f) - now driven from WSTessendorf::recordUpdateSpectrumIfWindChanged(),
// which maps the engine's global wind direction/strength (see
// water.hpp's setGlobalWindDirection()/setGlobalWindStrength()) onto an
// actual physical wind speed for this spectrum. windDir is expected
// pre-normalized by the caller.
layout(push_constant) uniform WindPushConstant {
  vec2 windDir;
  float windSpeed; // m/s
} wind;

// Hash function from https://www.shadertoy.com/view/4djSRW
vec2 uhash22(uvec2 n) {
    n ^= (n.yx >> 1);
    n *= 0x27d4eb2du;
    n ^= (n.yx >> 3);
    n *= 0x165667b1u;
    return vec2(n) / float(0xffffffffu);
}

// Gaussian from hashed seed
vec2 gaussian(uvec2 seed) {
    vec2 u = uhash22(seed);
    u = clamp(u, vec2(1e-6), vec2(1.0 - 1e-6)); // Avoid log(0)

    float r = sqrt(-2.0 * log(u.x));
    float theta = 6.28318530718 * u.y;

    return vec2(r * cos(theta), r * sin(theta));
}

const float m_A = 3e-7f;
const float oneOver2sqrt = 0.7071067812;
const float damping = 0.1;
const float animationPeriod = 200.f;
const float baseFreq = 2.0f * 3.14159265359 / animationPeriod;
const float g = 9.81;

float jonswapSpectrum(vec2 unitWaveVec, float k) {
    if (k < 1e-6) return 0.0;
    if (detailCascade != 0) {
        // Short gravity/capillary tail, isolated from the long-wave cascade.
        // Broad directionality gives crossing ripples rather than stripes.
        float alignment = dot(unitWaveVec, wind.windDir);
        float directional = 0.35 + 0.65 * alignment * alignment;
        float windEnergy = clamp(wind.windSpeed / 6.0, 0.0, 2.0);
        float band = smoothstep(12.0, 24.0, k);
        return 3e-5 * windEnergy * directional * band *
               exp(-k * k * 0.004 * 0.004) / (k * k * k);
    }
    const float k2 = k * k;
    const float k4 = k2 * k2;
    float cosFact = dot(unitWaveVec, wind.windDir);
    cosFact = cosFact * cosFact;
    const float L = wind.windSpeed * wind.windSpeed / g;
    const float k_p = 1.0 / L;
    const float sqrt_k = sqrt(k);
    const float sqrt_k_p = sqrt(k_p);
    const float gamma = 3.3;
    const float sigma = 0.08;
    float r = exp( - (sqrt_k - sqrt_k_p)*(sqrt_k - sqrt_k_p) / (2.0 * sigma*sigma * k_p) );
    float peakEnhancement = pow(gamma, r);
    float S = m_A * exp(-1.25 / (k2 * L*L)) / k4 * peakEnhancement * cosFact * exp(-k2 * damping * damping);
    return S;
}

vec2 baseWaveHeightFT(vec2 gaussRandom, vec2 unitWaveVec, float k) {
  return oneOver2sqrt * gaussRandom * sqrt(jonswapSpectrum(unitWaveVec, k));
}

vec2 conj(vec2 c) {
  return vec2(c.x, -c.y);
}

float DispersionDeepWaves(float k) {
  // Surface tension / density for water: capillary waves accelerate as
  // wavelength falls. Long waves retain the original gravity dispersion.
  return sqrt(g * k + (detailCascade != 0 ? 7.2e-5 * k * k * k : 0.0));
}

float QDispersion(float k) {
  if (detailCascade != 0) return DispersionDeepWaves(k);
  return floor(DispersionDeepWaves(k) / baseFreq) * baseFreq;
}

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    uint idx = id.y * tileSize + id.x;

    const WaveVector kWaveVec = waveVectors[idx];
    const float k = length(kWaveVec.vec);
    BaseWaveHeight h0;
    if (k > 0.00001) {
        uvec2 salt = detailCascade != 0 ? uvec2(193, 719) : uvec2(0);
        vec2 gaussRandom = gaussian(id + salt);
        h0.heightAmp = baseWaveHeightFT(gaussRandom, kWaveVec.unit, k);
        // h0*(-k) must come from the mirrored frequency's random seed.
        // Reusing h0(k)'s seed makes each mode a standing cosine wave.
        uvec2 mirrorId = (uvec2(tileSize) - id) % uvec2(tileSize);
        h0.heightAmp_conj = conj(baseWaveHeightFT(
            gaussian(mirrorId + salt), -kWaveVec.unit, k));
        h0.dispersion = QDispersion(k);
    } else {
        h0.heightAmp = vec2(0.0);
        h0.heightAmp_conj = vec2(0.0);
        h0.dispersion = 0.0;
    }
    baseWaveHeightField[idx] = h0;
}
