#version 450

layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 3) readonly buffer VisibleCountBuffer {
  uint visibleCount;
};

struct DrawIndirectCommand {
  uint vertexCount;
  uint instanceCount;
  uint firstVertex;
  uint firstInstance;
};

layout(std430, set = 0, binding = 4) buffer IndirectBuffer {
  DrawIndirectCommand command;
};

void main() {
  // Matches grassGenerate.comp and the host output capacity.
  command.instanceCount = min(visibleCount, 250000u);
}
