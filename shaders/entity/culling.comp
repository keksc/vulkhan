#version 450

// Pass 1 of 2 (see cullingFinalize.comp for pass 2).
//
// For every instance: frustum-test its world-space AABB. If visible,
// atomically claim the next free slot within its draw-command group and
// copy the instance into the compacted buffer at that slot. The atomic's
// return value doubles as both the compacted slot index and the running
// visible count for the group (read back in pass 2).
//
// `groupVisibleCounts` must be zeroed by the CPU before this dispatch runs.

layout(local_size_x = 64) in;

struct GPUInstanceData {
  mat4 modelMatrix;
  mat4 normalMatrix;
  vec4 color;
  vec3 aabbMin;
  int textureIndex;
  vec3 aabbMax;
  int mrTextureIndex;
  float roughnessFactor;
  float metallicFactor;
  int jointOffset;
  int groupIndex; // which entry in groupFirstInstance/groupVisibleCounts this instance belongs to
};

layout(set = 0, binding = 0) uniform CullingUbo {
  vec4 frustumPlanes[6];
  uint totalInstances;
  uint totalCommands;
} ubo;

layout(std430, set = 0, binding = 1) readonly buffer InstanceBuffer {
  GPUInstanceData instances[];
};

layout(std430, set = 0, binding = 2) writeonly buffer CompactedInstanceBuffer {
  GPUInstanceData compacted[];
};

layout(std430, set = 0, binding = 3) readonly buffer GroupFirstInstanceBuffer {
  uint groupFirstInstance[];
};

layout(std430, set = 0, binding = 4) buffer GroupVisibleCountBuffer {
  uint groupVisibleCounts[];
};

bool isInFrustum(vec3 minBounds, vec3 maxBounds) {
  vec3 center = (maxBounds + minBounds) * 0.5;
  vec3 extents = (maxBounds - minBounds) * 0.5;

  for (int i = 0; i < 6; i++) {
    vec4 plane = ubo.frustumPlanes[i];
    float radius = dot(abs(plane.xyz), extents);
    float distance = dot(plane.xyz, center) + plane.w;
    if (distance < -radius) {
      return false;
    }
  }
  return true;
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  if (idx >= ubo.totalInstances) return;

  GPUInstanceData inst = instances[idx];
  if (!isInFrustum(inst.aabbMin, inst.aabbMax)) return;

  uint slot = atomicAdd(groupVisibleCounts[inst.groupIndex], 1u);
  compacted[groupFirstInstance[inst.groupIndex] + slot] = inst;
}
