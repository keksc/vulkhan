#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(set=1,binding=0) uniform writeonly image2D outputImage;
layout(set=1,binding=1) uniform sampler2D sceneColor;
layout(push_constant) uniform Push { vec4 unused; } push;
void main() {
  ivec2 p=ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(p,imageSize(outputImage)))) return;
  vec3 linear=max(texelFetch(sceneColor,p,0).rgb,vec3(0));
  vec3 srgb=mix(1.055*pow(linear,vec3(1.0/2.4))-.055,
                linear*12.92,lessThanEqual(linear,vec3(.0031308)));
  imageStore(outputImage,p,vec4(clamp(srgb,0.0,1.0),1));
}
