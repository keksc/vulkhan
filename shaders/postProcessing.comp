#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "globalUbo.glsl"

layout(set = 1, binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(set = 1, binding = 1) uniform sampler2D sceneColor;
layout(set = 1, binding = 2) uniform sampler2D sceneDepth;

const int MAX_STEPS = 128;
const float SURF_EPS = 0.001;
const float MAX_DIST = 500.0;

const vec3 HALL_CENTER  = vec3(0.0, 0.0, 0.0);
const vec3 HALL_HALF    = vec3(8.0, 3.0, 5.0);

const vec3 WING_CENTER  = vec3(10.0, 2.5, 3.0);
const vec3 WING_HALF    = vec3(3.0, 2.5, 6.0);

const vec3 TOWER_CENTER = vec3(-9.0, 5.0, -4.0);
const vec3 TOWER_HALF   = vec3(2.0, 5.0, 2.0);

float maxcomp(vec3 v) {
  return max(v.z,max(v.x,v.y));
}

float sdBox(vec3 p, vec3 b) {
  vec3 d = abs(p)-b;
  return length(max(d,0.0)) + min(maxcomp(d),0.0);
}

float sdManor(vec3 p) {
  float d = sdBox(p - HALL_CENTER, HALL_HALF);
  d = min(d, sdBox(p - WING_CENTER, WING_HALF));
  d = min(d, sdBox(p - TOWER_CENTER, TOWER_HALF));
  return d;
}

void main() {
  ivec2 outSize = imageSize(outputImage);
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if (pixel.x >= outSize.x || pixel.y >= outSize.y)
    return;

  vec2 uv = (vec2(pixel) + 0.5) / vec2(outSize);
  vec3 color = texture(sceneColor, uv).rgb;
  float depth = texture(sceneDepth, uv).r;

  vec3 camPos = ubo.inverseView[3].xyz;
  mat4 invProjView = inverse(ubo.projView);

  vec2 ndc = uv * 2.0 - 1.0;
  vec4 nearP = invProjView * vec4(ndc, 1.0, 1.0); // reversed-Z: near = 1
  vec4 farP  = invProjView * vec4(ndc, 0.0, 1.0); // reversed-Z: far = 0
  nearP /= nearP.w;
  farP  /= farP.w;
  vec3 rayOrigin = nearP.xyz;
  vec3 rayDir = normalize(farP.xyz - nearP.xyz);

  // unproject the scene depth sample to world space to get true scene distance
  vec4 sceneWorldP = invProjView * vec4(ndc, depth, 1.0);
  sceneWorldP /= sceneWorldP.w;
  float sceneDist = distance(camPos, sceneWorldP.xyz);

  float t = 0.0;
  bool hit = false;
  vec3 hitPos;

  for (int i = 0; i < MAX_STEPS; i++) {
    vec3 p = rayOrigin + rayDir * t;
    float dist = sdManor(p);
    if (dist < SURF_EPS) {
      hit = true;
      hitPos = p;
      break;
    }
    t += dist;
    if (t > MAX_DIST)
      break;
  }

  vec3 finalColor = color;

  if (hit) {
    float hitDist = distance(camPos, hitPos);
    if (hitDist < sceneDist) {
      vec2 e = vec2(0.001, 0.0);
      vec3 normal = normalize(vec3(
        sdManor(hitPos + e.xyy) - sdManor(hitPos - e.xyy),
        sdManor(hitPos + e.yxy) - sdManor(hitPos - e.yxy),
        sdManor(hitPos + e.yyx) - sdManor(hitPos - e.yyx)
      ));
      vec3 lightDir = normalize(vec3(0.5, 1.0, 0.3));
      float ndotl = max(dot(normal, lightDir), 0.0);
      finalColor = vec3(0.8, 0.2, 0.2) * (0.2 + 0.8 * ndotl);
    }
  }

  vec3 srgb = pow(clamp(finalColor, 0.0, 1.0), vec3(1.0 / 2.2));
  imageStore(outputImage, pixel, vec4(srgb, 1.0));
}
